 NO_INLINE void HuC6280::RunSub(void)
@@ -635,6 +637,25 @@ NO_INLINE void HuC6280::RunSub(void)
 		}
 		PC &= 0xFFFF;     // Our cpu core can only handle PC going about 8192 bytes over, so make sure it never gets that far...
 
+		if(MDFN_UNLIKELY(rondo_exec_hook != NULL))
+		{
+			int owed = rondo_exec_hook(PC);
+
+			if(owed)
+			{
+				// The C ran in the routine's place: charge what the routine
+				// took, sampling interrupts where its last cycle would.
+				const int last = 3 << speed_shift_cache;
+
+				if(owed > last)
+					ADDCYC_MASTER(owed - last);
+				IRQSample = (IRQlow & IRQMask) & PIMaskCache;
+				IFlagSample = P & I_FLAG;
+				ADDCYC_MASTER(owed > last ? last : owed);
+				P &= ~T_FLAG;
+				continue;
+			}
+		}
 		lastop = RdOpcode(PC);
 
 		PC++;
