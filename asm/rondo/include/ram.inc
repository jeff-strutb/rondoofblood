OBJ_FLASH_FRAMES = $34B8 ; the screen flash object's use of OBJ_WORK_D: frames left (StageFlashStart, StageFlashEnd)
OBJ_TALLY_WAIT = $3510 ; the player's use of OBJ_WORK_E in the stage tally: the wait StageSubStepTally sets
OBJ_TALLY_STEP = $3568 ; the player's use of OBJ_WORK_F in the stage tally: cleared by StageSubStepTally
MariaStandSteps = $A5E7 ; three words by OBJ_SUBSTATE: standing still, the attack, the item crash (MariaStateStand)
MariaCrouchSteps = $A8A2 ; five words by OBJ_SUBSTATE: crouched, the attack, nothing, going down, standing up (MariaStateCrouch)
MariaSlideAhead = $B095 ; how far ahead the slide check reads, by facing: 7, -7 (MariaSlideCheck)
MariaSlideSpeeds = $B0FF ; her slide's X speed by facing, two words: $02C0, $FD40 (MariaSlideStart)
zBurstCount = $DA ; MariaStart9AObjects's use of zHitSlot: how many of its $9A objects it has started
MariaLedgeStates = $ABF3 ; the hold she takes on a ledge from a jump, by facing, plus 2 for the ledge behind her: states 5, 8, 7, 6 (MariaLedgePose)
MariaLedgeFrames = $ABF7 ; her frame in that hold (MariaLedgePose)
MariaLedgeAnimations = $ABFB ; her OBJ_ANIMATION in that hold (MariaLedgePose)
MariaLedgeNudgeX = $ABFF ; what her X moves by onto the ledge ahead, by column 0's pixel across its tile (MariaLandOnMarked)
MariaLedgeNudgeY = $AC07 ; what her Y moves by onto the ledge ahead, by the same pixel (MariaLandOnMarked)
MariaLedgeNudgeXBehind = $AC0F ; what her X moves by onto the ledge behind her, by the same pixel (MariaLandOnMarked)
MariaLedgeNudgeYBehind = $AC17 ; what her Y moves by onto the ledge behind her, by the same pixel (MariaLandOnMarked)
MariaFallDriftSpeeds = $AD16 ; her X speed when the fall's drift delay ends, by facing: $0040, $FFC0 (MariaStateFall)
WalkScrollStepByRoute = $843C ; the scroll's X step high byte in a walk-out by route: 1 right, $FF left (StageWalkOutScroll)
WalkPlayerStepByRoute = $843E ; what the player's X low gets each frame of a walk-out by route
WalkStopXByRoute = $8440 ; the player's X low a walk-out stops at by route
StageGateFrames = $99EB ; a gate's first frame by side (the start argument's bit 0)
StageGateLists = $99ED ; added to a gate's frame to give its list by side
OBJ_GATE_STEP = $3510 ; a stage gate's use of OBJ_WORK_E: the step of its opening, 0 to 3
OBJ_FLYER_WAIT = $3510 ; the dropped flyer's use of OBJ_WORK_E: its wait
OBJ_FLY_PHASE = $3670 ; the dropped flyer's use of $3670: 0 flying, 4 once it turns back
OBJ_SPAWN_HELD = $37D0 ; the flyer's use of OBJ_WORK_M: not zero, it drops no new pickup
OBJ_CHILD_ORDER = $3568 ; what the flyer tells the pickup in slot $50 through its OBJ_WORK_F: 1 new, 2 again
OBJ_FALL_LO = $3618 ; an object's use of OBJ_WORK_H: the low byte of what MariaObjectFallCapped and RichterObjectFallCapped add to its Y speed each frame
OBJ_FALL_HI = $3670 ; an object's use of OBJ_WORK_I: the high byte of OBJ_FALL_LO's acceleration
MariaAttackStates = $C773 ; the states of her attack's object, four words: start, fly, fall, return (MariaAttackObject)
MariaAttackAngles = $C823 ; the angle her attack's object turns back on, by its facing (MariaAttackFall)
MariaItem5States = $C8E5 ; the states of item 5, four words (MariaItem5)
