+// For the decomp's harness: beside each FIFO byte, the disc byte it came
+// from (absolute LBA * 2048 + offset), or none; and that of the byte on DB.
+#define RONDO_NONE 0xFFFFFFFFu
+static uint32_t rondo_din_origin[2048];
+uint32_t rondo_db_origin = RONDO_NONE;
+
+static void rondo_din_mark(uint32_t lba, uint32_t len)
+{
+ for(uint32_t i = 0; i < len; i++)
+  rondo_din_origin[(din->write_pos + i) & (din->data.size() - 1)] =
+   lba == RONDO_NONE ? RONDO_NONE : lba * 2048 + i;
+}
+
 static TOC toc;
 
 static uint32_t read_sec_start;
@@ -286,6 +299,7 @@ void SCSICD_Power(scsicd_timestamp_t system_timestamp)
