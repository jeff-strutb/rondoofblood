 {
  cd_bus.DB = data;
+ rondo_db_origin = RONDO_NONE;
 }
 
 void SCSICD_SetACK(bool set)
@@ -455,12 +469,14 @@ static void SendStatusAndMessage(uint8_t status, uint8_t message)
    cd_bus.DB = 0x00;
  else
    cd_bus.DB = 0x01;
+ rondo_db_origin = RONDO_NONE;
 
  ChangePhase(PHASE_STATUS);
 }
 
 static void DoSimpleDataIn(const uint8_t *data_in, uint32_t len)
 {
+ rondo_din_mark(RONDO_NONE, len);
  din->Write(data_in, len);
 
  cd.data_transfer_done = true;
@@ -1322,6 +1338,7 @@ static INLINE void RunCDRead(uint32_t system_timestamp, int32_t run_time)
     {
      memcpy(cd.SubPWBuf, tmp_read_buf + 2352, 96);
 
+     rondo_din_mark(SectorAddr, 2048);
      if(tmp_read_buf[12 + 3] == 0x2)
       din->Write(tmp_read_buf + 24, 2048);
      else
@@ -1513,6 +1530,7 @@ uint32_t SCSICD_Run(scsicd_timestamp_t system_timestamp)
      // Status sent, so get ready to send the message!
      cd.status_sent = FALSE;
      cd_bus.DB = cd.message_pending;
+     rondo_db_origin = RONDO_NONE;
 
      ChangePhase(PHASE_MESSAGE_IN);
     }
@@ -1534,6 +1552,7 @@ uint32_t SCSICD_Run(scsicd_timestamp_t system_timestamp)
      }
      else
      {
+      rondo_db_origin = rondo_din_origin[din->read_pos];
       cd_bus.DB = din->ReadByte();
       SetREQ(TRUE);
      }
