+// For the oracles. Before each instruction: nonzero means the C ran in its
+// place, and that many master clocks are owed. Before each write: the byte.
+typedef int (*rondo_exec_t)(uint32 pc);
+extern rondo_exec_t rondo_exec_hook;
+extern rondo_wr_t rondo_wr_pre_hook;
 }
 
