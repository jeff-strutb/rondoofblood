index de2c4c9..08b4303 100644
--- a/mednafen/pce/huc.cpp
+++ b/mednafen/pce/huc.cpp
@@ -581,3 +581,50 @@ extern "C" __attribute__((visibility("default"))) void rondo_set_hooks(rondo_rd_
 	rondo_wr_hook = wr;
 	rondo_irq_hook = irq;
 }
+
+// The oracles: registers, MPRs, the clock, the bus.
+extern "C" __attribute__((visibility("default"))) void rondo_set_check_hooks(rondo_exec_t exec, rondo_wr_t wr_pre)
+{
+	rondo_exec_hook = exec;
+	rondo_wr_pre_hook = wr_pre;
+}
+
+extern "C" __attribute__((visibility("default"))) void rondo_get_regs(uint8 *a, uint8 *x, uint8 *y, uint8 *s, uint8 *p, uint16 *pc)
+{
+	HuCPU.GetRegs(a, x, y, s, p, pc);
+}
+
+extern "C" __attribute__((visibility("default"))) void rondo_set_regs(uint8 a, uint8 x, uint8 y, uint8 s, uint8 p, uint16 pc)
+{
+	HuCPU.SetRegs(a, x, y, s, p, pc);
+}
+
+extern "C" __attribute__((visibility("default"))) void rondo_set_mpr(unsigned i, uint8 v)
+{
+	HuCPU.PokeMPR(i, v);
+}
+
+extern "C" __attribute__((visibility("default"))) uint32 rondo_timestamp(void)
+{
+	return HuCPU.Timestamp();
+}
+
+extern "C" __attribute__((visibility("default"))) uint8 rondo_bus_rd(uint16 addr)
+{
+	return HuCPU.BusRead(addr);
+}
+
+extern "C" __attribute__((visibility("default"))) void rondo_bus_wr(uint16 addr, uint8 v)
+{
+	HuCPU.BusWrite(addr, v);
+}
+
+extern "C" __attribute__((visibility("default"))) void rondo_bus_st(unsigned reg, uint8 v)
+{
+	HuCPU.BusST(reg, v);
+}
+
+extern "C" __attribute__((visibility("default"))) void rondo_charge(int master)
+{
+	HuCPU.StealMasterCycles(master);
+}
